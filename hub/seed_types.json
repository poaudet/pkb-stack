{"person":{"description":"A person the owner knows.","unique_key":"name",
 "text_template":"{name} ({relationship}). Birthday: {birthday}. Habits: {habits}. Interests: {interests}. {notes}",
 "json_schema":{"type":"object","required":["name"],"properties":{
  "name":{"type":"string","description":"Person's name."},
  "birthday":{"type":"string","format":"date","description":"Date of birth."},
  "relationship":{"type":"string","description":"How they relate to the owner. 'self' only for the owner's own record."},
  "contact":{"type":"object","properties":{
    "email":{"type":"string"},"phone":{"type":"string"}}},
  "habits":{"type":"array","items":{"type":"string"},"description":"Recurring routines or activities. NOT projects, work tasks or one-off events."},
  "interests":{"type":"array","items":{"type":"string"},"description":"Topics, foods, hobbies or things they like."},
  "notes":{"type":"string","description":"Short free text. Do not use for facts that have a field."}}}},
"event":{"description":"Something that happened or will happen on a date.",
 "text_template":"{date} {kind}: {title} at {location}. {notes}",
 "json_schema":{"type":"object","required":["date","title"],"properties":{
  "date":{"type":"string","format":"date","description":"Date the event happens or happened."},
  "title":{"type":"string","description":"Short name of the event."},
  "kind":{"type":"string","description":"Category of event."},
  "location":{"type":"string","description":"Place where it happens."},
  "people":{"type":"array","items":{"type":"string"},"x-ref":"person"},
  "notes":{"type":"string","description":"Additional event details."}}}},
"message":{"description":"A message exchanged with a contact.",
 "text_template":"{at} {direction} {contact}: {text}",
 "json_schema":{"type":"object","required":["contact","at","text"],
  "properties":{
  "contact":{"type":"string","description":"Name or label of the other participant."},
  "contact_uid":{"type":"string","x-ref":"person"},
  "at":{"type":"string","format":"date-time","description":"When the message was exchanged."},
  "direction":{"type":"string","enum":["in","out"]},
  "channel":{"type":"string","description":"How the message was sent."},
  "text":{"type":"string","description":"The message content."}}}},
"memory":{"description":"A memory worth keeping.",
 "text_template":"{date} {title}. {description}",
 "json_schema":{"type":"object","required":["title","description"],
  "properties":{
  "date":{"type":"string","format":"date","description":"Date of the remembered fact."},
  "title":{"type":"string","description":"Short title for the memory."},
  "description":{"type":"string","description":"The fact or memory to retain."},
  "tags":{"type":"array","items":{"type":"string"}},
  "people":{"type":"array","items":{"type":"string"},"x-ref":"person"}}}}}
