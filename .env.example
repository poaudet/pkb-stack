DATA_DIR=/data
PORT=5000
GUNICORN_THREADS=4
API_TOKEN=
MAX_BODY_MB=2

EMBED_BACKEND=local
EMBED_MODEL=intfloat/multilingual-e5-small
# EMBED_BACKEND=openai: EMBED_MODEL is the remote model name; changing it needs POST /api/admin/reindex
EMBED_BASE_URL=
EMBED_API_KEY=
MODEL_CACHE_DIR=/opt/models
VECTOR_BACKEND=auto

# LLM tidy-up (phase 2); enabled iff LLM_MODEL is set
LLM_BASE_URL=
LLM_API_KEY=not-needed
LLM_MODEL=
LLM_TIMEOUT=300
LLM_CONCURRENCY=1
LLM_MAX_INPUT_CHARS=12000

AGENT_NOTES_REQUIRE_REVIEW=true
TOOLS_ALLOW_DESTRUCTIVE=false
MIRROR_MARKDOWN=true
BACKUP_KEEP=14
LOG_LEVEL=INFO
# compose only: BIND_ADDR=127.0.0.1  RCLONE_REMOTE=protondrive:KnowledgeHub
# MCP bridge (compose profile `mcp`): MCP_PORT=8000  MCP_TRANSPORT=stdio|streamable-http
