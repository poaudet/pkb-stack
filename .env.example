DATA_DIR=/data
PORT=5000
GUNICORN_THREADS=4
API_TOKEN=
MAX_BODY_MB=2

EMBED_BACKEND=local
EMBED_MODEL=intfloat/multilingual-e5-small
# EMBED_BACKEND=openai: EMBED_MODEL is the remote model name; changing it needs POST /api/admin/reindex
EMBED_BASE_URL=
EMBED_API_KEY=
MODEL_CACHE_DIR=/opt/models
VECTOR_BACKEND=auto

# LLM tidy-up (phase 2); enabled iff LLM_MODEL is set
LLM_BASE_URL=
LLM_API_KEY=not-needed
LLM_MODEL=
LLM_TIMEOUT=300
LLM_CONCURRENCY=1
LLM_MAX_INPUT_CHARS=12000
# Optional selectable endpoints (JSON array) for tidy-up and capture; pick them on the Settings tab.
# Overrides LLM_BASE_URL/LLM_MODEL and CAPTURE_LLM_BASE_URL/CAPTURE_LLM_MODEL when non-empty.
# LLM_ENDPOINTS=[{"name":"local","base_url":"http://host.docker.internal:11434/v1","model":"llama3","api_key":"not-needed"},{"name":"remote","base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","api_key":"sk-..."}]
LLM_ENDPOINTS=

# Smart Capture
CAPTURE_ENABLED=true
CAPTURE_LLM_BASE_URL=
CAPTURE_LLM_API_KEY=
CAPTURE_LLM_MODEL=
CAPTURE_LLM_EXTRA_HEADERS=
CAPTURE_LLM_TIMEOUT=120
CAPTURE_LLM_MAX_TOKENS=4000
CAPTURE_MAX_CHARS=8000
CAPTURE_MAX_OPS=20
CAPTURE_CANDIDATES=25
# Keep application-owned records out of Capture; policy flags can hide additional types.
CAPTURE_EXCLUDE_TYPES=place_visit,task,grocery_list,grocery_item,plainlist_settings
CAPTURE_BLOCK_SECRETS=true
CAPTURE_DAILY_CALL_LIMIT=60
CAPTURE_KEEP_RAW_DAYS=30
HUB_TIMEZONE=UTC
OWNER_NAME=
CAPTURE_ALLOW_SCHEMA_CHANGES=true
CAPTURE_MAX_NEW_FIELDS=5
CAPTURE_GAP_FILL=true
CAPTURE_GAP_MAX=8
CAPTURE_GAP_DEFAULT_INCLUDE=true
CAPTURE_CATALOG_MAX_CHARS=5000
# Long capture mode: auto switches to chunked extraction above the threshold; off disables it.
CAPTURE_LONG_MODE=auto
CAPTURE_LONG_THRESHOLD_CHARS=4000
CAPTURE_LONG_MAX_CHARS=60000
CAPTURE_CHUNK_TARGET_CHARS=3000
CAPTURE_CHUNK_OVERLAP_CHARS=300
CAPTURE_LONG_MAX_CHUNKS=24
CAPTURE_LONG_CONCURRENCY=1

AGENT_NOTES_REQUIRE_REVIEW=true
TOOLS_ALLOW_DESTRUCTIVE=false
TOOLS_ALLOW_EXTEND=true
MIRROR_MARKDOWN=true
BACKUP_KEEP=14
LOG_LEVEL=INFO
# compose only: BIND_ADDR=127.0.0.1  RCLONE_REMOTE=protondrive:KnowledgeHub
# MCP bridge (docker-compose.mcp.yml / docker-compose.hub-mcp.yml; HTTP needs the same API_TOKEN as bearer): MCP_PORT=8000  MCP_TRANSPORT=stdio|streamable-http

# Auth: API_TOKEN must be >=32 chars. PKB_AUTH_MODE=token|proxy|none (default: token if API_TOKEN set, else none)
PKB_AUTH_MODE=
# proxy mode: trust this header from your reverse proxy (only expose the hub through it)
PKB_AUTH_PROXY_HEADER=X-Forwarded-User
# Number of trusted reverse proxies in front of the hub. When >0 the failed-login limiter keys on the
# client address from X-Forwarded-For instead of the proxy address. Leave 0 when not behind a proxy.
PKB_TRUSTED_PROXY_HOPS=0

# Sensitive-data guard: PKB_GUARD_<DETECTOR>=redact|block|off (see docs/GUARD_CONFIG.md)
# PKB_GUARD_ALLOW=
# PKB_GUARD_ALLOW_PATTERNS=
# PKB_GUARD_CONFIG=

# Batch endpoint operation cap
PKB_BATCH_MAX_OPS=100
